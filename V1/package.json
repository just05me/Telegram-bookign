{
  "name": "telegram-booking",
  "private": true,
  "workspaces": [
    "packages/server",
    "packages/webapp"
  ],
  "scripts": {
    "dev:server": "npm run dev -w packages/server",
    "dev:webapp": "npm run dev -w packages/webapp",
    "build:server": "npm run build -w packages/server",
    "build:webapp": "npm run build -w packages/webapp",
    "db:migrate": "npm run db:migrate -w packages/server",
    "db:generate": "npm run db:generate -w packages/server",
    "lint": "npm run lint -w packages/server && npm run lint -w packages/webapp",
    "tunnel": "bash scripts/start-tunnel.sh"
  }
}
