# Database
# For PostgreSQL: "postgresql://postgres:postgres@localhost:5432/telegram_booking"
DATABASE_URL="file:./dev.db"

# Telegram Bot
BOT_TOKEN="your_telegram_bot_token"
BOT_WEBHOOK_URL=""  # optional, for webhook mode; leave empty for polling

# Server
PORT=3001
FRONTEND_URL="http://localhost:3000"
SESSION_SECRET="your-session-secret-change-me"

# Google Calendar OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/callback"

# Encryption key for Google refresh tokens
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# ngrok tunnel (for local HTTPS development)
# Get token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=""
